#!/usr/bin/env python3
import sys
import os
import time
import subprocess
import urllib.request
import urllib.parse

NOTIF_BG_SYMLINK = os.path.expanduser("~/.local/state/caelestia/notif_bg")
WALLPAPER_CURRENT = os.path.expanduser("~/.local/state/caelestia/wallpaper/current")
DOWNLOAD_TARGET = os.path.expanduser("~/.local/state/caelestia/downloaded_notif_bg.jpg")

GREEN = "\033[1;32m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
RED = "\033[1;31m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

def print_help():
    print(f"\n{CYAN}{BOLD}🔔 NOTIFY CLI - Quản lý Giao diện Thông Báo Caelestia{RESET}\n")
    print(f"{BOLD}Cách dùng:{RESET}")
    print(f"  {GREEN}notify bg <đường_dẫn_ảnh_hoặc_link>{RESET}")
    print(f"      Đổi hình nền thẻ thông báo sang ảnh bất kỳ (file máy tính hoặc link web)")
    print(f"      {DIM}Ví dụ:{RESET} notify bg ~/Pictures/my_anime.png")
    print(f"      {DIM}Ví dụ:{RESET} notify bg https://example.com/cool_image.jpg")
    print(f"  {GREEN}notify bg wallpaper{RESET}")
    print(f"      Tự động lấy hình nền Desktop hiện tại làm nền thông báo")
    print(f"  {GREEN}notify test{RESET}")
    print(f"      Bắn thông báo thử nghiệm để xem giao diện ngay lập tức\n")

def reload_shell():
    print(f"{CYAN}⚡ Đang nạp lại giao diện thông báo...{RESET}")
    subprocess.run(["caelestia", "shell", "-k"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.8)
    subprocess.Popen(["caelestia", "shell", "-d"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(1.2)

def send_test_notif(msg="Đã đổi hình nền thẻ thông báo thành công!"):
    subprocess.run([
        "notify-send",
        "-i", "messenger",
        "-a", "Messenger",
        "Notify Customizer",
        msg
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def change_bg(arg):
    target_path = ""

    # Option 1: Keyword "wallpaper"
    if arg.lower() in ["wallpaper", "current", "desktop"]:
        if os.path.exists(WALLPAPER_CURRENT):
            target_path = os.path.realpath(WALLPAPER_CURRENT)
            print(f"{CYAN}🖼️ Đang lấy hình nền Desktop hiện tại:{RESET} {target_path}")
        else:
            print(f"{RED}Không tìm thấy hình nền desktop hiện tại!{RESET}")
            return

    # Option 2: Web URL
    elif arg.startswith("http://") or arg.startswith("https://"):
        print(f"{CYAN}🌐 Đang tải ảnh từ web:{RESET} {arg}")
        try:
            headers = {"User-Agent": "Mozilla/5.0"}
            req = urllib.request.Request(arg, headers=headers)
            with urllib.request.urlopen(req) as response, open(DOWNLOAD_TARGET, "wb") as out_file:
                out_file.write(response.read())
            target_path = DOWNLOAD_TARGET
            print(f"{GREEN}✔ Tải ảnh thành công!{RESET}")
        except Exception as e:
            print(f"{RED}Lỗi khi tải ảnh từ URL:{RESET} {e}")
            return

    # Option 3: Local file path
    else:
        abs_path = os.path.abspath(os.path.expanduser(arg))
        if not os.path.exists(abs_path):
            print(f"{RED}❌ Không tìm thấy file ảnh tại:{RESET} {abs_path}")
            return
        target_path = abs_path

    # Check valid image extension
    valid_exts = (".jpg", ".jpeg", ".png", ".webp", ".svg", ".bmp")
    if not target_path.lower().endswith(valid_exts):
        print(f"{YELLOW}⚠️ Cảnh báo: File không có đuôi ảnh phổ biến ({valid_exts}), nhưng vẫn tiếp tục.{RESET}")

    # Update symlink
    try:
        if os.path.islink(NOTIF_BG_SYMLINK) or os.path.exists(NOTIF_BG_SYMLINK):
            os.remove(NOTIF_BG_SYMLINK)
        os.symlink(target_path, NOTIF_BG_SYMLINK)
        print(f"{GREEN}✔ Đã liên kết hình nền mới:{RESET} {target_path}")
    except Exception as e:
        print(f"{RED}Lỗi khi tạo symlink:{RESET} {e}")
        return

    # Reload and test
    reload_shell()
    send_test_notif(f"Đã cập nhật hình nền mới từ: {os.path.basename(target_path)}")
    print(f"{GREEN}🎉 Hoàn tất! Đã bắn thông báo thử nghiệm lên góc màn hình.{RESET}\n")

def main():
    if len(sys.argv) < 2:
        print_help()
        return

    cmd = sys.argv[1].lower()

    if cmd == "bg" and len(sys.argv) >= 3:
        change_bg(" ".join(sys.argv[2:]))
    elif cmd == "test":
        send_test_notif("Đây là thông báo thử nghiệm từ lệnh notify test!")
        print(f"{GREEN}✔ Đã bắn thông báo test lên màn hình!{RESET}")
    else:
        print_help()

if __name__ == "__main__":
    main()
