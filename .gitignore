# ========================================================
# SECURITY & SECRETS (NEVER COMMIT)
# ========================================================
*.local.*
*.bashrc.local
*.local.sh
*.local.bash
*.local.fish
*.local.env
*.key
*.pem
*.token
*.secret
*secrets*
*credentials*
.env
.env.*
.git-credentials
fish_variables
00-secrets.fish
projects.json
shell-tokens.json

# ========================================================
# TEMPORARY & CACHE FILES
# ========================================================
*.log
*.tmp
*.bak
*.save
*.swp
*~
*.orig
__pycache__/
.cache/
.local/state/
node_modules/

# Allow tracked .local directories
!/.local/
!/.local/bin/
!/.local/bin/**
!/.local/share/
!/.local/share/fcitx5/
!/.local/share/fcitx5/**

# ========================================================
# BROWSER / SYSTEM SESSIONS & HISTORY
# ========================================================
*history*
*.session
*.sqlite
*.sqlite3
*.db
*.ldb

# ========================================================
# LARGE BINARIES / MEDIA (Exclude raw/huge unneeded assets)
# ========================================================
*.tar.*
*.zip
*.iso
*.bin
daft_raw.jpg
daft_test54.jpg
daft_sharp.jpg
daft_head_boosted.jpg
daft_large_54.jpg
daft_helmets.jpg

# ========================================================
# PRIVATE PICTURES / DIRECTORIES (EXCLUDED BY USER)
